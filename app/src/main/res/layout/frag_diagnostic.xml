<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_diagnostic_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/diagnostic_title"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tv_diagnostic_description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/diagnostic_description"
            android:layout_marginBottom="16dp"
            app:layout_constraintTop_toBottomOf="@id/tv_diagnostic_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/btn_run_diagnostics"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/diagnostic_run"
            android:layout_marginBottom="16dp"
            app:layout_constraintTop_toBottomOf="@id/tv_diagnostic_description"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/btn_run_diagnostics"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tv_diagnostic_report"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:background="?android:attr/selectableItemBackground"
            android:padding="8dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            app:layout_constraintTop_toBottomOf="@id/progress_bar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/btn_request_notification_permission"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/diagnostic_request_notification_permission"
            android:visibility="gone"
            android:layout_marginBottom="8dp"
            app:layout_constraintTop_toBottomOf="@id/tv_diagnostic_report"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/btn_copy_report"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/diagnostic_copy"
            android:enabled="false"
            android:layout_marginEnd="4dp"
            app:layout_constraintTop_toBottomOf="@id/btn_request_notification_permission"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_share_report"
            app:layout_constraintBottom_toBottomOf="parent" />

        <Button
            android:id="@+id/btn_share_report"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/diagnostic_share"
            android:enabled="false"
            android:layout_marginStart="4dp"
            app:layout_constraintTop_toBottomOf="@id/btn_request_notification_permission"
            app:layout_constraintStart_toEndOf="@id/btn_copy_report"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
