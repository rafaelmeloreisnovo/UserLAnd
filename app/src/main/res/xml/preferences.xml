<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <PreferenceCategory
        android:title="@string/pref_app_category"
        android:key="pref_app_category"
        app:iconSpaceReserved="false">
        <ListPreference
            android:key="pref_default_nav_location"
            android:title="@string/pref_default_landing_page_title"
            android:summary="@string/pref_default_landing_page_message"
            android:entries="@array/default_landing_pages"
            android:entryValues="@array/default_landing_pages"
            android:defaultValue="@string/apps"
            app:iconSpaceReserved="false"/>
        <Preference
            android:key="pref_clear_auto_start"
            android:title="@string/pref_clear_auto_start_title"
            android:summary="@string/pref_clear_auto_start_summary"
            app:iconSpaceReserved="false"/>
        <CheckBoxPreference
            android:key="pref_custom_scaling_enabled"
            android:title="@string/pref_custom_scaling_enabled_title"
            android:summary="@string/pref_custom_scaling_enabled_summary"
            android:defaultValue="false"
            app:iconSpaceReserved="false"/>
        <EditTextPreference
            android:dependency="pref_custom_scaling_enabled"
            android:key="pref_scaling"
            android:title="@string/pref_scaling_title"
            android:inputType="number"
            android:defaultValue="1"
            app:iconSpaceReserved="false"/>
        <CheckBoxPreference
            android:key="pref_opt_in"
            android:title="@string/opt_in_preference"
            android:summary="@string/opt_in_preference_summary"
            android:defaultValue="false"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>
    <PreferenceCategory
        android:title="@string/pref_proot_category"
        android:key="pref_proot_category"
        app:iconSpaceReserved="false">
        <CheckBoxPreference
            android:key="pref_proot_debug_enabled"
            android:title="@string/pref_proot_debugging_enabled_title"
            android:summary="@string/pref_proot_debugging_enabled_summary"
            android:defaultValue="false"
            app:iconSpaceReserved="false"/>
        <ListPreference
            android:dependency="pref_proot_debug_enabled"
            android:key="pref_proot_debug_level"
            android:title="@string/pref_proot_debugging_level_title"
            android:summary="@string/pref_proot_debugging_level_summary"
            android:entries="@array/proot_debug_levels"
            android:entryValues="@array/proot_debug_levels"
            android:defaultValue="@string/pref_proot_debugging_level_default"
            app:iconSpaceReserved="false"/>
        <Preference
            android:dependency="pref_proot_debug_enabled"
            android:key="pref_proot_delete_debug_file"
            android:title="@string/pref_proot_delete_debug_file_title"
            app:iconSpaceReserved="false"/>
    </PreferenceCategory>
    <PreferenceCategory
        android:title="@string/pref_safety_guard_status_title"
        android:key="pref_safety_guard_category"
        app:iconSpaceReserved="false">
        <CheckBoxPreference
            android:key="pref_safety_guard_enabled"
            android:title="@string/pref_safety_guard_enabled_title"
            android:summary="@string/pref_safety_guard_enabled_summary"
            android:defaultValue="true"
            app:iconSpaceReserved="false"/>
        <Preference
            android:key="pref_safety_guard_status"
            android:title="@string/pref_safety_guard_status_title"
            android:summary="@string/pref_safety_guard_status_none"
            app:iconSpaceReserved="false"/>
        <Preference
            android:key="pref_safety_guard_clear"
            android:title="@string/pref_safety_guard_clear_title"
            app:iconSpaceReserved="false"/>
        <CheckBoxPreference
            android:dependency="pref_safety_guard_enabled"
            android:key="pref_safety_guard_indicator"
            android:title="@string/pref_safety_guard_indicator_title"
            android:summary="@string/pref_safety_guard_indicator_summary"
            android:defaultValue="true"
            app:iconSpaceReserved="false"/>
        <CheckBoxPreference
            android:dependency="pref_safety_guard_enabled"
            android:key="pref_safety_guard_logging"
            android:title="@string/pref_safety_guard_logging_title"
            android:summary="@string/pref_safety_guard_logging_summary"
            android:defaultValue="true"
            app:iconSpaceReserved="false"/>
        <CheckBoxPreference
            android:dependency="pref_safety_guard_enabled"
            android:key="pref_safety_guard_safe_mode"
            android:title="@string/pref_safety_guard_safe_mode_title"
            android:summary="@string/pref_safety_guard_safe_mode_summary"
            android:defaultValue="false"
            app:iconSpaceReserved="false"/>
        <Preference
            android:key="pref_safety_guard_clear_last_event"
            android:title="@string/pref_safety_guard_clear_last_event_title"
            app:iconSpaceReserved="false"/>
    </PreferenceCategory>
</PreferenceScreen>
