 /*
 * RAFAELIA — "música matemática" em C puro (C11)
 * - discreto (matriz/grafo) ⊕ contínuo (espiral/ângulo) ⊕ topologia (toro) ⊕ ética (filtro interno)
 * - entrada opcional via stdin: números (um por linha) viram "Verbo" (perturbação controlada)
 *
 * build:
 *   cc -std=c11 -O2 rafaelia_musica.c -lm -o rafaelia_musica
 *
 * run:
 *   ./rafaelia_musica 120 1337
 *   printf "0.1\n0.2\n-0.05\n" | ./rafaelia_musica 80 42
 */
#include <stdio.h>
#include <stdlib.h>
#include <stdint.h>
#include <string.h>
#include <math.h>

#ifndef M_PI
#define M_PI 3.14159265358979323846
#endif

/* tokens/constantes (simbólicas e operacionais) */
static const double SQRT3_DIV_2 = 0.86602540378443864676; /* √3/2 */
static const double PHI         = 1.61803398874989484820; /* φ */
static const double EPS         = 1e-12;

typedef struct {
  double v[6];     /* ψ χ ρ Δ Σ Ω */
  double angle;    /* fase (espiral) */
  double mem_u;    /* toro u */
  double mem_w;    /* toro w */
  uint64_t step;
} Rafaelia;

/* xorshift64* (determinístico) */
static uint64_t xs64(uint64_t *s){
  uint64_t x = *s;
  x ^= x >> 12;
  x ^= x << 25;
  x ^= x >> 27;
  *s = x;
  return x * 2685821657736338717ULL;
}
static double urand01(uint64_t *s){
  /* [0,1) com 53 bits */
  return (xs64(s) >> 11) * (1.0/9007199254740992.0);
}
static double sgn(double x){ return (x < 0.0) ? -1.0 : 1.0; }

/* CRC32 (Bytewise) */
static uint32_t crc32_u8(const uint8_t *data, size_t n){
  uint32_t crc = 0xFFFFFFFFu;
  for(size_t i=0;i<n;i++){
    crc ^= (uint32_t)data[i];
    for(int k=0;k<8;k++){
      uint32_t m = -(crc & 1u);
      crc = (crc >> 1) ^ (0xEDB88320u & m);
    }
  }
  return ~crc;
}

/* normaliza vetor para probabilidades (|v|) */
static void probs_from_vec(const double v[6], double p[6]){
  double s = 0.0;
  for(int i=0;i<6;i++){
    p[i] = fabs(v[i]);
    s += p[i];
  }
  if(s < EPS){
    for(int i=0;i<6;i++) p[i] = 1.0/6.0;
  }else{
    for(int i=0;i<6;i++) p[i] /= s;
  }
}

/* entropia de Shannon (base e) */
static double shannon_entropy(const double p[6]){
  double H = 0.0;
  for(int i=0;i<6;i++){
    if(p[i] > EPS) H -= p[i] * log(p[i]);
  }
  return H;
}

/* coerência = 1 - H/Hmax  (Hmax=log(6)) */
static double coherence_from_entropy(double H){
  const double Hmax = log(6.0);
  double c = 1.0 - (H / (Hmax + EPS));
  if(c < 0.0) c = 0.0;
  if(c > 1.0) c = 1.0;
  return c;
}

/* "Ethica[8]" compacta: 8 métricas → 1 fator (0..1) */
static double ethica8_factor(const Rafaelia *R){
  double p[6]; probs_from_vec(R->v, p);
  double H  = shannon_entropy(p);
  double C  = coherence_from_entropy(H);

  /* 8 sinais (mínimo viável) */
  double e1 = C;                                     /* coerência */
  double e2 = 1.0 - fabs(R->v[2]);                   /* ρ baixo = ruído baixo */
  double e3 = 1.0 - fmin(1.0, fabs(R->v[3]));        /* Δ não explode */
  double e4 = fmin(1.0, fabs(R->v[4]));              /* Σ (memória) presente */
  double e5 = fmin(1.0, fabs(R->v[5]));              /* Ω (fecho) presente */
  double e6 = 1.0 - fmin(1.0, fabs(R->v[0]-R->v[1]));/* ψ≈χ */
  double e7 = 1.0 - fmin(1.0, fabs(R->v[1]-R->v[4]));/* χ≈Σ */
  double e8 = 1.0 - fmin(1.0, fabs(R->v[0]-R->v[5]));/* ψ≈Ω */

  double prod = 1.0;
  prod *= fmax(0.0, fmin(1.0, e1));
  prod *= fmax(0.0, fmin(1.0, e2));
  prod *= fmax(0.0, fmin(1.0, e3));
  prod *= fmax(0.0, fmin(1.0, e4));
  prod *= fmax(0.0, fmin(1.0, e5));
  prod *= fmax(0.0, fmin(1.0, e6));
  prod *= fmax(0.0, fmin(1.0, e7));
  prod *= fmax(0.0, fmin(1.0, e8));

  /* raiz 8 → suaviza (não zera brutal) */
  return pow(prod + EPS, 1.0/8.0);
}

/* filtro ético interno: contrai ruído e impede overflow */
static void ethics_filter(Rafaelia *R){
  double p[6]; probs_from_vec(R->v, p);
  double H  = shannon_entropy(p);
  double C  = coherence_from_entropy(H);
  double E  = ethica8_factor(R);

  /* λ = (√3/2) * coerência * ética  (0..√3/2) */
  double lambda = SQRT3_DIV_2 * C * E;

  /* ruído ρ contrai; memória Σ/Ω preserva */
  R->v[2] *= (0.85 + 0.15*lambda);          /* ρ */
  R->v[4] *= (0.95 + 0.05*lambda);          /* Σ */
  R->v[5] *= (0.95 + 0.05*lambda);          /* Ω */

  /* saturação suave (tanh) */
  for(int i=0;i<6;i++){
    R->v[i] = tanh(R->v[i]);
  }
}

/* grafo: anel ψ→χ→ρ→Δ→Σ→Ω→ψ + cordas (ψ↔Σ, χ↔Ω) */
static void graph_step(const Rafaelia *R, double out[6]){
  /* matriz de acoplamento (simétrica) */
  static const double W[6][6] = {
    /* ψ  χ   ρ   Δ   Σ   Ω */
    {0, .30, 0,  0, .15, .25}, /* ψ */
    {.30,0, .30, 0,  0, .15},  /* χ */
    {0, .30,0, .30, 0,  0},    /* ρ */
    {0,  0, .30,0, .30, 0},    /* Δ */
    {.15,0,  0, .30,0, .30},   /* Σ */
    {.25,.15,0,  0, .30,0}     /* Ω */
  };

  /* Laplaciano discreto: out = x + α*(Wx - D*x) */
  double x[6]; memcpy(x, R->v, sizeof(x));
  double Wx[6]={0}, Dx[6]={0};
  for(int i=0;i<6;i++){
    double di=0.0;
    for(int j=0;j<6;j++){
      Wx[i] += W[i][j]*x[j];
      di    += W[i][j];
    }
    Dx[i] = di * x[i];
  }
  const double alpha = 0.72;
  for(int i=0;i<6;i++){
    out[i] = x[i] + alpha*(Wx[i] - Dx[i]);
  }
}

/* contínuo: rotação espiral acoplando (ψ,χ) e (Σ,Ω) */
static void spiral_step(Rafaelia *R, double lambda){
  /* fase cresce com λ e φ: música/ritmo */
  R->angle += (0.12 + 0.18*lambda) * PHI;
  double a = R->angle;

  /* rotação 2D em (ψ,χ) */
  double c = cos(a), s = sin(a);
  double psi = R->v[0], chi = R->v[1];
  R->v[0] =  c*psi - s*chi;
  R->v[1] =  s*psi + c*chi;

  /* contra-rotação em (Σ,Ω) (fecho de memória) */
  double b = -a * SQRT3_DIV_2;
  double cb = cos(b), sb = sin(b);
  double Sig = R->v[4], Om = R->v[5];
  R->v[4] = cb*Sig - sb*Om;
  R->v[5] = sb*Sig + cb*Om;
}

/* toro: memória como ciclo fechado */
static void torus_embed(Rafaelia *R, double *X, double *Y, double *Z){
  /* u e w evoluem com o estado (sem tempo absoluto) */
  double s1 = R->v[0] + R->v[3] + 0.5*R->v[5];
  double s2 = R->v[1] + R->v[2] + 0.5*R->v[4];

  R->mem_u += 0.20 * tanh(s1);
  R->mem_w += 0.17 * tanh(s2);

  /* wrap em [0,2π) */
  if(R->mem_u > 2*M_PI) R->mem_u -= 2*M_PI;
  if(R->mem_u < 0)      R->mem_u += 2*M_PI;
  if(R->mem_w > 2*M_PI) R->mem_w -= 2*M_PI;
  if(R->mem_w < 0)      R->mem_w += 2*M_PI;

  /* toro padrão */
  double Rmaj = 2.0, rmin = 0.65;
  *X = (Rmaj + rmin*cos(R->mem_w)) * cos(R->mem_u);
  *Y = (Rmaj + rmin*cos(R->mem_w)) * sin(R->mem_u);
  *Z = rmin * sin(R->mem_w);
}

/* “Verbo”: injeta um escalar no ψ e distribui via Δ/Σ */
static void apply_verbo(Rafaelia *R, double verbo){
  R->v[0] += verbo;           /* ψ recebe sopro */
  R->v[3] += 0.33*verbo;      /* Δ transduz */
  R->v[4] += 0.21*verbo;      /* Σ registra */
}

/* um ciclo completo */
static void step_cycle(Rafaelia *R){
  /* leitura não-bloqueante de um “verbo” (stdin pode acabar) */
  double verbo = 0.0;
  int got = 0;
  {
    /* tenta ler uma linha; se não tiver, segue sem */
    char buf[128];
    if(fgets(buf, sizeof(buf), stdin)){
      char *end = NULL;
      double x = strtod(buf, &end);
      if(end != buf){
        verbo = x;
        got = 1;
      }
    }
  }
  if(got) apply_verbo(R, verbo);

  /* 1) discreto: grafo/laplaciano */
  double nxt[6];
  graph_step(R, nxt);
  memcpy(R->v, nxt, sizeof(nxt));

  /* 2) ética: calcula λ e estabiliza */
  double p[6]; probs_from_vec(R->v, p);
  double H  = shannon_entropy(p);
  double C  = coherence_from_entropy(H);
  double E  = ethica8_factor(R);
  double lambda = SQRT3_DIV_2 * C * E;

  ethics_filter(R);

  /* 3) contínuo: espiral/rotação */
  spiral_step(R, lambda);

  /* 4) reforça fecho (Ω puxa Σ puxa ψ) */
  R->v[5] += 0.07 * tanh(R->v[4]); /* Ω <- Σ */
  R->v[4] += 0.05 * tanh(R->v[0]); /* Σ <- ψ */
  R->v[0] += 0.03 * tanh(R->v[5]); /* ψ <- Ω */

  /* 5) saturação final */
  for(int i=0;i<6;i++) R->v[i] = tanh(R->v[i]);

  R->step++;
}

/* log compacto */
static void print_state(const Rafaelia *R){
  double p[6]; probs_from_vec(R->v, p);
  double H  = shannon_entropy(p);
  double C  = coherence_from_entropy(H);
  double E  = ethica8_factor(R);
  double lambda = SQRT3_DIV_2 * C * E;

  Rafaelia tmp = *R;
  double X,Y,Z;
  torus_embed(&tmp, &X, &Y, &Z);

  /* CRC do estado (v + angle + mem_u + mem_w) */
  struct {
    double v[6];
    double angle, mem_u, mem_w;
    uint64_t step;
  } pack;
  memcpy(pack.v, R->v, sizeof(pack.v));
  pack.angle = R->angle;
  pack.mem_u = R->mem_u;
  pack.mem_w = R->mem_w;
  pack.step  = R->step;

  uint32_t crc = crc32_u8((const uint8_t*)&pack, sizeof(pack));

  printf("t=%llu | ψχρΔΣΩ=[%+.5f %+.5f %+.5f %+.5f %+.5f %+.5f] | H=%.5f C=%.5f λ=%.5f | Toro=(%.3f,%.3f,%.3f) | CRC32=%08x\n",
    (unsigned long long)R->step,
    R->v[0],R->v[1],R->v[2],R->v[3],R->v[4],R->v[5],
    H, C, lambda,
    X,Y,Z,
    crc
  );
}

int main(int argc, char **argv){
  int steps = 120;
  uint64_t seed = 1337;

  if(argc >= 2) steps = atoi(argv[1]);
  if(argc >= 3) seed  = (uint64_t)strtoull(argv[2], NULL, 10);
  if(steps < 1) steps = 1;
  if(steps > 200000) steps = 200000;

  Rafaelia R;
  memset(&R, 0, sizeof(R));

  /* init “música”: começa no silêncio com leve assimetria */
  uint64_t s = seed ^ 0x9E3779B97F4A7C15ULL;
  for(int i=0;i<6;i++){
    double r = urand01(&s)*2.0 - 1.0; /* [-1,1] */
    R.v[i] = 0.12 * r;
  }
  R.v[0] += 0.18; /* ψ */
  R.v[4] += 0.11; /* Σ */
  R.v[5] += 0.09; /* Ω */
  R.angle = 0.0;
  R.mem_u = 0.0;
  R.mem_w = 0.0;
  R.step  = 0;

  /* cabeçalho */
  printf("RAFAELIA_MUSICA :: steps=%d seed=%llu :: (discreto⊕contínuo⊕toro⊕ética)\n",
         steps, (unsigned long long)seed);

  /* roda */
  for(int k=0;k<steps;k++){
    step_cycle(&R);
    /* log a cada passo (você pode reduzir se quiser) */
    print_state(&R);
  }

  /* fecho: escore final (produto “E↔C” + coerência) */
  double p[6]; probs_from_vec(R.v, p);
  double H  = shannon_entropy(p);
  double C  = coherence_from_entropy(H);

  double prod = 1.0;
  for(int i=0;i<6;i++) prod *= (fabs(R.v[i]) + 1e-6);
  double score = C * log(1.0 + prod);

  printf("Ω_fecho :: C=%.6f | score=%.6f | (ψ→χ→ρ→Δ→Σ→Ω→ψ)\n", C, score);
  return 0;
}
