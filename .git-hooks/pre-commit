#!/usr/bin/env bash
# Pre-commit hook for UserLAnd project
# This is an OPTIONAL hook that helps ensure compilation before committing
#
# To install this hook:
#   cp .git-hooks/pre-commit .git/hooks/pre-commit
#   chmod +x .git/hooks/pre-commit
#
# To skip this hook temporarily:
#   git commit --no-verify

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

echo "🔍 Running pre-commit compilation checks..."

# Run the compilation guarantee script
if ! "$ROOT_DIR/scripts/ensure_compilation.sh"; then
    echo ""
    echo "❌ Pre-commit compilation checks failed!"
    echo ""
    echo "To fix:"
    echo "  1. Review the errors above"
    echo "  2. Run: ./scripts/ensure_compilation.sh"
    echo "  3. Fix any issues found"
    echo ""
    echo "To bypass this check (not recommended):"
    echo "  git commit --no-verify"
    echo ""
    exit 1
fi

echo ""
echo "✅ Pre-commit compilation checks passed!"
echo ""

exit 0
